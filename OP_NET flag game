<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OP Flag Quest | OP_NET</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#05050f;--bg2:#0b0b1c;--bg3:#111124;--bg4:#181830;--bg5:#1e1e3a;
  --orange:#f7931a;--orange2:#ffb347;--orange-glow:rgba(247,147,26,0.25);
  --purple:#7c3aed;--cyan:#06b6d4;--green:#10b981;--red:#ef4444;--yellow:#eab308;
  --text:#eeeeff;--text2:#8888aa;--text3:#44446a;
  --border:rgba(247,147,26,0.18);--border2:rgba(255,255,255,0.06);
}
body{
  font-family:-apple-system,'Segoe UI',system-ui,sans-serif;
  background:var(--bg);color:var(--text);min-height:100vh;
  display:flex;flex-direction:column;align-items:center;overflow-x:hidden;
}
body::before{
  content:'';position:fixed;inset:0;
  background-image:linear-gradient(rgba(247,147,26,0.025) 1px,transparent 1px),
    linear-gradient(90deg,rgba(247,147,26,0.025) 1px,transparent 1px);
  background-size:36px 36px;pointer-events:none;z-index:0;
}
.container{
  width:100%;max-width:460px;min-height:100vh;
  display:flex;flex-direction:column;
  position:relative;z-index:1;padding:0 12px 80px;
}
/* SCREENS */
.screen{display:none;flex-direction:column;align-items:center;width:100%;padding:16px 0;animation:fadeUp 0.35s ease;}
.screen.active{display:flex;}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
/* LOGO */
.logo-wrap{display:flex;flex-direction:column;align-items:center;margin-bottom:22px;}
.logo-hex{
  width:62px;height:62px;
  background:linear-gradient(135deg,var(--orange),#d4690a);
  clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);
  display:flex;align-items:center;justify-content:center;
  font-size:20px;font-weight:900;color:#000;letter-spacing:-1px;
  box-shadow:0 0 36px var(--orange-glow);margin-bottom:10px;
}
.logo-title{
  font-size:26px;font-weight:900;letter-spacing:3px;
  background:linear-gradient(90deg,var(--orange),var(--orange2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.logo-sub{font-size:11px;color:var(--text2);letter-spacing:3px;text-transform:uppercase;margin-top:3px;}
/* CARD */
.card{background:var(--bg3);border:1px solid var(--border);border-radius:16px;padding:20px;width:100%;margin-bottom:14px;}
.card-title{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--orange);margin-bottom:14px;display:flex;align-items:center;gap:6px;}
/* INVITE BANNER */
.invite-banner{
  background:var(--bg3);border:1px solid var(--border);border-radius:14px;
  padding:14px 16px;display:flex;align-items:center;justify-content:space-between;
  width:100%;margin-bottom:18px;
}
.invite-bar{width:120px;height:7px;background:var(--bg5);border-radius:4px;overflow:hidden;margin-top:6px;}
.invite-fill{height:100%;background:linear-gradient(90deg,var(--orange),#e07820);border-radius:4px;transition:width 0.5s;}
.invite-count{font-size:20px;font-weight:800;color:var(--orange);}
.invite-info{font-size:11px;color:var(--text2);}
/* FORM */
.form-group{margin-bottom:14px;}
.form-label{font-size:11px;font-weight:700;color:var(--text2);letter-spacing:1px;text-transform:uppercase;margin-bottom:7px;display:block;}
.form-input{
  width:100%;background:var(--bg4);border:1px solid var(--border2);border-radius:10px;
  padding:11px 14px;color:var(--text);font-size:14px;font-family:inherit;outline:none;transition:border-color 0.2s;
}
.form-input:focus{border-color:var(--orange);}
.form-input::placeholder{color:var(--text3);}
.platform-toggle{display:flex;gap:8px;margin-bottom:14px;}
.platform-btn{
  flex:1;padding:9px;border-radius:10px;border:1px solid var(--border2);
  background:var(--bg4);color:var(--text2);font-size:13px;font-weight:600;
  cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:5px;font-family:inherit;
}
.platform-btn.active{border-color:var(--orange);background:rgba(247,147,26,0.1);color:var(--orange);}
/* BUTTONS */
.btn{width:100%;padding:13px;border-radius:12px;border:none;font-size:14px;font-weight:700;cursor:pointer;transition:all 0.2s;font-family:inherit;}
.btn-primary{background:linear-gradient(135deg,var(--orange),#d4690a);color:#000;box-shadow:0 4px 20px rgba(247,147,26,0.28);}
.btn-primary:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 6px 28px rgba(247,147,26,0.4);}
.btn-primary:disabled{opacity:0.4;cursor:not-allowed;}
.btn-secondary{background:var(--bg4);border:1px solid var(--border2);color:var(--text);}
.btn-secondary:hover{background:var(--bg5);}
.btn-sm{width:auto;padding:8px 14px;font-size:12px;border-radius:8px;white-space:nowrap;}
.btn-row{display:flex;gap:10px;width:100%;}
.btn-row .btn{flex:1;}
/* GAME HEADER */
.game-header{display:flex;align-items:center;justify-content:space-between;width:100%;padding:10px 0;margin-bottom:10px;}
.score-chip{display:flex;align-items:center;gap:5px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:7px 12px;}
.score-val{font-size:17px;font-weight:800;color:var(--orange);}
.score-lbl{font-size:10px;color:var(--text2);font-weight:600;}
.streak-chip{display:flex;align-items:center;gap:4px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:7px 12px;font-size:13px;font-weight:700;color:var(--yellow);}
.q-prog{font-size:12px;color:var(--text2);font-weight:600;}
/* TIMER */
.timer-wrap{width:100%;height:5px;background:var(--bg3);border-radius:3px;margin-bottom:16px;overflow:hidden;}
.timer-bar{height:100%;border-radius:3px;background:var(--green);transition:width 1s linear,background-color 0.3s;}
/* FLAG */
.flag-display{font-size:96px;text-align:center;line-height:1.1;margin:14px 0;animation:flagPop 0.4s cubic-bezier(0.175,0.885,0.32,1.275);}
@keyframes flagPop{from{transform:scale(0.4);opacity:0;}to{transform:scale(1);opacity:1;}}
.q-text{text-align:center;font-size:14px;color:var(--text2);margin-bottom:16px;font-weight:500;}
/* ANSWERS */
.answers-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;width:100%;margin-bottom:12px;}
.answer-btn{
  padding:13px 8px;border-radius:12px;border:1.5px solid var(--border2);background:var(--bg4);
  color:var(--text);font-size:13px;font-weight:600;cursor:pointer;transition:all 0.2s;
  font-family:inherit;text-align:center;line-height:1.3;
}
.answer-btn:hover:not(:disabled){border-color:var(--orange);background:rgba(247,147,26,0.1);transform:scale(1.02);}
.answer-btn.correct{border-color:var(--green)!important;background:rgba(16,185,129,0.15)!important;color:var(--green)!important;}
.answer-btn.wrong{border-color:var(--red)!important;background:rgba(239,68,68,0.15)!important;color:var(--red)!important;}
.answer-btn:disabled{cursor:not-allowed;}
.feedback{height:34px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:600;transition:all 0.3s;}
/* POINTS POPUP */
.pts-popup{
  position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
  font-size:40px;font-weight:900;pointer-events:none;z-index:200;display:none;
  text-shadow:0 0 30px currentColor;
}
@keyframes ptsPop{
  0%{transform:translate(-50%,-50%) scale(0.5);opacity:1;}
  50%{transform:translate(-50%,-80%) scale(1.3);opacity:1;}
  100%{transform:translate(-50%,-130%) scale(1);opacity:0;}
}
/* RESULT */
.result-score{font-size:62px;font-weight:900;color:var(--orange);text-align:center;line-height:1;text-shadow:0 0 50px var(--orange-glow);}
.result-lbl{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--text2);text-align:center;margin-top:4px;margin-bottom:18px;}
.stats-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:18px;}
.stat-box{background:var(--bg4);border:1px solid var(--border2);border-radius:10px;padding:12px;text-align:center;}
.stat-val{font-size:22px;font-weight:800;}
.stat-lbl{font-size:10px;color:var(--text2);text-transform:uppercase;letter-spacing:1px;margin-top:2px;}
/* LEADERBOARD */
.lb-item{
  display:flex;align-items:center;padding:9px 10px;border-radius:10px;
  margin-bottom:5px;background:var(--bg4);border:1px solid transparent;transition:all 0.2s;
}
.lb-item.is-me{border-color:var(--orange);background:rgba(247,147,26,0.08);}
.rank-badge{width:27px;height:27px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;margin-right:9px;flex-shrink:0;}
.rk1{background:linear-gradient(135deg,#ffd700,#ffa500);color:#000;}
.rk2{background:linear-gradient(135deg,#c0c0c0,#909090);color:#000;}
.rk3{background:linear-gradient(135deg,#cd7f32,#8b4513);color:#fff;}
.rk-n{background:var(--bg5);color:var(--text2);}
.lb-name{flex:1;font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.lb-plat{font-size:11px;color:var(--text2);margin-left:3px;}
.lb-score{font-size:14px;font-weight:700;color:var(--orange);}
.lb-score-lbl{font-size:10px;color:var(--text2);}
/* OPSCAN */
.scan-input-row{display:flex;gap:8px;}
.scan-link{
  display:block;margin-top:10px;padding:11px 14px;background:var(--bg4);
  border:1px solid var(--border);border-radius:10px;font-size:12px;color:var(--cyan);
  text-decoration:none;text-align:center;font-family:'Courier New',monospace;word-break:break-all;transition:all 0.2s;
}
.scan-link:hover{background:var(--bg5);color:var(--orange);}
.stat-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px;}
/* BOTTOM NAV */
.bottom-nav{
  position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:460px;
  background:var(--bg2);border-top:1px solid var(--border);display:flex;z-index:50;padding:3px 0;
}
.nav-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:1px;padding:8px 4px;border:none;background:transparent;color:var(--text2);font-size:10px;font-weight:600;cursor:pointer;font-family:inherit;transition:all 0.2s;}
.nav-btn.active{color:var(--orange);}
.nav-icon{font-size:19px;}
/* TOAST */
.toast{position:fixed;top:16px;left:50%;transform:translateX(-50%) translateY(-10px);background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:10px 18px;font-size:13px;font-weight:600;z-index:999;opacity:0;pointer-events:none;transition:all 0.28s;white-space:nowrap;}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
.toast.ok{border-color:var(--green);color:var(--green);}
.toast.err{border-color:var(--red);color:var(--red);}
.toast.info{border-color:var(--orange);color:var(--orange);}
/* MISC */
.divider{width:100%;height:1px;background:var(--border2);margin:14px 0;}
.text-center{text-align:center;}
.text-orange{color:var(--orange);}
.text-muted{color:var(--text2);font-size:13px;}
.mt-8{margin-top:8px;}
.mt-16{margin-top:16px;}
.badge-orange{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:6px;font-size:11px;font-weight:600;background:rgba(247,147,26,0.12);color:var(--orange);border:1px solid rgba(247,147,26,0.28);}
.powered{text-align:center;font-size:11px;color:var(--text3);margin-top:14px;letter-spacing:1px;}
.powered span{color:var(--orange);font-weight:700;}
@media(max-width:400px){.flag-display{font-size:76px;}.answers-grid{gap:7px;}.answer-btn{font-size:12px;padding:11px 6px;}}
</style>
</head>
<body>

<div class="toast" id="toast"></div>
<div class="pts-popup" id="ptsPopup"></div>

<div class="container">

  <!-- ============ SIGNUP SCREEN ============ -->
  <div class="screen active" id="screen-signup">
    <div class="logo-wrap" style="margin-top:24px;">
      <div class="logo-hex">OP</div>
      <div class="logo-title">OP_NET</div>
      <div class="logo-sub">⚡ Flag Quest</div>
    </div>

    <div class="invite-banner">
      <div>
        <div class="invite-info">🎟️ Invite Slots</div>
        <div class="invite-bar"><div class="invite-fill" id="iFill"></div></div>
      </div>
      <div style="text-align:right;">
        <div class="invite-count" id="iCount">247 / 300</div>
        <div class="invite-info" id="iLeft">53 slots left</div>
      </div>
    </div>

    <div class="card">
      <div class="card-title">🚀 Create Account</div>

      <div class="form-group">
        <label class="form-label">Platform</label>
        <div class="platform-toggle">
          <button class="platform-btn active" id="btn-discord" onclick="setPlatform('discord')">💬 Discord</button>
          <button class="platform-btn" id="btn-x" onclick="setPlatform('x')">𝕏 X / Twitter</button>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" id="uLabel">Discord Username</label>
        <input class="form-input" id="uInput" type="text" placeholder="e.g. satoshi#1234" maxlength="32" autocomplete="off">
      </div>

      <div class="form-group">
        <label class="form-label">OP Wallet Address <span style="color:var(--text3);font-size:10px;">(optional)</span></label>
        <input class="form-input" id="wInput" type="text" placeholder="bc1q… or 0x…" maxlength="128" autocomplete="off" style="font-size:12px;font-family:monospace;">
      </div>

      <button class="btn btn-primary" onclick="doSignup()">⚡ Enter OP Flag Quest</button>
      <p class="text-muted text-center mt-8" style="font-size:12px;">Earn <strong class="text-orange">OP Points</strong> by guessing flags correctly & fast!</p>
    </div>

    <div class="powered">Powered by <span>OP_NET</span> · Built on Bitcoin</div>
  </div>

  <!-- ============ GAME SCREEN ============ -->
  <div class="screen" id="screen-game">
    <div class="game-header">
      <div class="score-chip">
        <span style="font-size:15px;">⚡</span>
        <span class="score-val" id="scoreDisp">0</span>
        <span class="score-lbl">OP</span>
      </div>
      <span class="q-prog" id="qProg">1 / 10</span>
      <div class="streak-chip">🔥 <span id="streakDisp">0</span></div>
    </div>

    <div class="timer-wrap"><div class="timer-bar" id="timerBar"></div></div>

    <div class="card" style="text-align:center;padding:18px 16px 14px;">
      <div class="q-text">🌍 Which country does this flag belong to?</div>
      <div class="flag-display" id="flagDisp">🏳</div>
      <div class="answers-grid" id="answersGrid"></div>
      <div class="feedback" id="feedbackEl"></div>
    </div>

    <div class="powered">Powered by <span>OP_NET</span></div>
  </div>

  <!-- ============ RESULT SCREEN ============ -->
  <div class="screen" id="screen-result">
    <div style="display:flex;flex-direction:column;align-items:center;margin:18px 0 14px;">
      <div class="logo-hex" style="width:50px;height:50px;font-size:17px;margin-bottom:8px;">OP</div>
      <div style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:var(--text2);">🏆 Round Complete!</div>
    </div>

    <div class="card text-center">
      <div class="result-score" id="finalScore">0</div>
      <div class="result-lbl">OP Points Earned This Round</div>

      <div class="stats-row">
        <div class="stat-box"><div class="stat-val" id="rCorrect">0</div><div class="stat-lbl">Correct</div></div>
        <div class="stat-box"><div class="stat-val" id="rStreak">0</div><div class="stat-lbl">Best Streak</div></div>
        <div class="stat-box"><div class="stat-val" id="rAccuracy">0%</div><div class="stat-lbl">Accuracy</div></div>
      </div>

      <div class="divider"></div>

      <div class="btn-row">
        <button class="btn btn-secondary" onclick="gotoLB()">🏅 Leaderboard</button>
        <button class="btn btn-primary" onclick="playAgain()">🔄 Play Again</button>
      </div>
    </div>
    <div class="powered">Powered by <span>OP_NET</span></div>
  </div>

  <!-- ============ LEADERBOARD SCREEN ============ -->
  <div class="screen" id="screen-leaderboard">
    <div style="display:flex;align-items:center;justify-content:space-between;width:100%;margin-bottom:16px;padding-top:6px;">
      <div>
        <div style="font-size:20px;font-weight:800;">🏅 Leaderboard</div>
        <div style="font-size:11px;color:var(--text2);">Top OP Points Earners</div>
      </div>
      <span class="badge-orange">🎟️ <span id="lbSlots">247</span>/300</span>
    </div>

    <div class="card" style="padding:10px;">
      <div id="lbList"></div>
    </div>

    <div class="powered">Powered by <span>OP_NET</span></div>
  </div>

  <!-- ============ OPSCAN SCREEN ============ -->
  <div class="screen" id="screen-opscan">
    <div style="display:flex;align-items:center;gap:12px;width:100%;margin-bottom:16px;padding-top:6px;">
      <div style="font-size:30px;">🔍</div>
      <div>
        <div style="font-size:20px;font-weight:800;">OPSCAN</div>
        <div style="font-size:11px;color:var(--text2);">OP_NET Explorer Integration</div>
      </div>
    </div>

    <div class="card">
      <div class="card-title">🔎 Address Lookup</div>
      <div class="scan-input-row">
        <input class="form-input" id="scanAddr" placeholder="Enter address or tx hash…" style="font-size:12px;font-family:monospace;">
        <button class="btn btn-primary btn-sm" onclick="doScan()">Scan →</button>
      </div>
      <div id="scanResult"></div>
    </div>

    <div class="card">
      <div class="card-title">⚡ Quick Links</div>
      <a class="scan-link" href="https://opscan.io" target="_blank">🌐 opscan.io — OP_NET Block Explorer</a>
      <a class="scan-link" href="https://opnet.org" target="_blank" style="margin-top:8px;">📡 opnet.org — Official Website</a>
      <a class="scan-link" href="https://github.com/btc-vision/opnet" target="_blank" style="margin-top:8px;">💻 github.com/btc-vision/opnet</a>
    </div>

    <div class="card">
      <div class="card-title">📊 My Stats</div>
      <div class="stat-row"><span class="text-muted">Username</span><span id="myName" style="font-weight:700;color:var(--orange);">—</span></div>
      <div class="stat-row"><span class="text-muted">Platform</span><span id="myPlat" style="font-weight:600;">—</span></div>
      <div class="stat-row"><span class="text-muted">Best Score</span><span id="myScore" style="font-weight:700;color:var(--orange);">0 OP</span></div>
      <div class="stat-row"><span class="text-muted">Global Rank</span><span id="myRank" style="font-weight:700;color:var(--orange);">—</span></div>
      <div class="stat-row" style="margin-bottom:0;">
        <span class="text-muted">Wallet</span>
        <span id="myWallet" style="font-size:11px;font-family:monospace;color:var(--cyan);max-width:180px;text-align:right;word-break:break-all;">—</span>
      </div>
    </div>

    <div class="powered">Powered by <span>OP_NET</span></div>
  </div>

</div>

<!-- BOTTOM NAV -->
<div class="bottom-nav" id="bNav" style="display:none;">
  <button class="nav-btn active" id="nav-game" onclick="nav('game')"><span class="nav-icon">🎮</span>Play</button>
  <button class="nav-btn" id="nav-leaderboard" onclick="nav('leaderboard')"><span class="nav-icon">🏅</span>Ranks</button>
  <button class="nav-btn" id="nav-opscan" onclick="nav('opscan')"><span class="nav-icon">🔍</span>OPSCAN</button>
</div>

<script>
// ─── DATA ────────────────────────────────────────────────────
const FLAGS=[
  {f:'🇺🇸',n:'United States'},{f:'🇬🇧',n:'United Kingdom'},{f:'🇫🇷',n:'France'},
  {f:'🇩🇪',n:'Germany'},{f:'🇯🇵',n:'Japan'},{f:'🇨🇳',n:'China'},
  {f:'🇮🇳',n:'India'},{f:'🇧🇷',n:'Brazil'},{f:'🇨🇦',n:'Canada'},
  {f:'🇦🇺',n:'Australia'},{f:'🇮🇹',n:'Italy'},{f:'🇪🇸',n:'Spain'},
  {f:'🇲🇽',n:'Mexico'},{f:'🇷🇺',n:'Russia'},{f:'🇰🇷',n:'South Korea'},
  {f:'🇳🇱',n:'Netherlands'},{f:'🇸🇦',n:'Saudi Arabia'},{f:'🇦🇷',n:'Argentina'},
  {f:'🇿🇦',n:'South Africa'},{f:'🇳🇬',n:'Nigeria'},{f:'🇵🇹',n:'Portugal'},
  {f:'🇸🇪',n:'Sweden'},{f:'🇳🇴',n:'Norway'},{f:'🇩🇰',n:'Denmark'},
  {f:'🇫🇮',n:'Finland'},{f:'🇵🇱',n:'Poland'},{f:'🇺🇦',n:'Ukraine'},
  {f:'🇹🇷',n:'Turkey'},{f:'🇮🇩',n:'Indonesia'},{f:'🇵🇭',n:'Philippines'},
  {f:'🇹🇭',n:'Thailand'},{f:'🇻🇳',n:'Vietnam'},{f:'🇲🇾',n:'Malaysia'},
