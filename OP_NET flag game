function updateLB(){
  const idx=G.leaderboard.findIndex(x=>x.u.toLowerCase()===G.username.toLowerCase());
  if(idx>=0){if(G.totalScore>G.leaderboard[idx].s)G.leaderboard[idx].s=G.totalScore;}
  else{G.leaderboard.push({u:G.username,p:G.platform,s:G.totalScore});}
  G.leaderboard.sort((a,b)=>b.s-a.s);
  G.myRank=G.leaderboard.findIndex(x=>x.u.toLowerCase()===G.username.toLowerCase())+1;
}

