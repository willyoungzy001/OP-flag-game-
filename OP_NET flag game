}

function doSignup(){
  const u=document.getElementById('uInput').value.trim();
  const w=document.getElementById('wInput').value.trim();
  if(!u){toast('⚠️ Enter your username!','err');return;}
  if(u.length<2){toast('⚠️ Username too short!','err');return;}
  if(G.inviteUsed>=G.maxInvite){toast('❌ No invite slots remaining!','err');return;}
  const exists=G.leaderboard.find(x=>x.u.toLowerCase()===u.toLowerCase());
  if(!exists){G.inviteUsed++;updateInvite();}
  G.username=u;G.wallet=w;
  G.totalScore=exists?exists.s:0;
  toast(`🚀 Welcome, ${u}! Good luck!`,'ok');
  startGame();
}

// ─── GAME ───────────────────────────────────────────────────
function startGame(){
  G.score=0;G.streak=0;G.bestStreak=0;G.correct=0;G.qIndex=0;G.answered=false;
  G.questions=shuffle(FLAGS).slice(0,G.totalQ);
  updateHeader();
  showScreen('game');
  loadQ();
}

function loadQ(){
  if(G.qIndex>=G.totalQ){endGame();return;}
  clearInterval(G.timerID);
  G.answered=false;
  const q=G.questions[G.qIndex];
  G.curQ=q;
  document.getElementById('qProg').textContent=`${G.qIndex+1} / ${G.totalQ}`;
  const fd=document.getElementById('flagDisp');
  fd.textContent=q.f;
  fd.style.animation='none';
  requestAnimationFrame(()=>{fd.style.animation='flagPop 0.4s cubic-bezier(0.175,0.885,0.32,1.275)';});
  // answers
  const pool=FLAGS.filter(c=>c.n!==q.n);
  const opts=shuffle([q,...shuffle(pool).slice(0,3)]);
  const grid=document.getElementById('answersGrid');
  grid.innerHTML='';
  opts.forEach(o=>{
    const b=document.createElement('button');
    b.className='answer-btn';
    b.textContent=o.n;
    b.onclick=()=>handleAns(b,o.n,q.n);
    grid.appendChild(b);
  });
  document.getElementById('feedbackEl').textContent='';
  document.getElementById('feedbackEl').style.color='';
  // timer
  G.timerVal=15;
  setTimerBar(15,15);
  G.timerID=setInterval(()=>{
    G.timerVal--;
    setTimerBar(G.timerVal,15);
    if(G.timerVal<=0){clearInterval(G.timerID);handleTimeout();}
  },1000);
}

function setTimerBar(v,max){
  const pct=(v/max)*100;
  const bar=document.getElementById('timerBar');
  bar.style.width=pct+'%';
  bar.style.background=pct>50?'var(--green)':pct>25?'var(--yellow)':'var(--red)';
}

function handleAns(btn,chosen,correct){
  if(G.answered)return;
  G.answered=true;
  clearInterval(G.timerID);
  document.querySelectorAll('.answer-btn').forEach(b=>{
    b.disabled=true;
    if(b.textContent===correct)b.classList.add('correct');
  });
  const ok=chosen===correct;
  if(ok){
    btn.classList.add('correct');
    G.correct++;G.streak++;
    if(G.streak>G.bestStreak)G.bestStreak=G.streak;
    let pts=100+Math.floor((G.timerVal/15)*50)+(G.streak-1)*25;
    G.score+=pts;
    G.totalScore+=pts;
    showPts(pts);
    document.getElementById('feedbackEl').textContent=`✅ Correct! +${pts} OP`;
    document.getElementById('feedbackEl').style.color='var(--green)';
    toast(`✅ +${pts} OP${G.streak>1?' 🔥 x'+G.streak+' Streak!':''}`, 'ok');
  } else {
    btn.classList.add('wrong');
    G.streak=0;
    document.getElementById('feedbackEl').textContent=`❌ It was ${correct}`;
    document.getElementById('feedbackEl').style.color='var(--red)';
  }
  updateHeader();
  setTimeout(()=>{G.qIndex++;loadQ();},1700);
}

function handleTimeout(){
  if(G.answered)return;
  G.answered=true;G.streak=0;
  const correct=G.curQ.n;
  document.querySelectorAll('.answer-btn').forEach(b=>{
    b.disabled=true;
    if(b.textContent===correct)b.classList.add('correct');
  });
  document.getElementById('feedbackEl').textContent=`⏰ Time's up! → ${correct}`;
  document.getElementById('feedbackEl').style.color='var(--yellow)';
  updateHeader();
  setTimeout(()=>{G.qIndex++;loadQ();},1700);
}

function updateHeader(){
  document.getElementById('scoreDisp').textContent=G.score.toLocaleString();
  document.getElementById('streakDisp').textContent=G.streak;
}

function endGame(){
  clearInterval(G.timerID);
  updateLB();
  document.getElementById('finalScore').textContent=G.score.toLocaleString();
  document.getElementById('rCorrect').textContent=`${G.correct}/${G.totalQ}`;
  document.getElementById('rStreak').textContent=G.bestStreak;
  document.getElementById('rAccuracy').textContent=Math.round((G.correct/G.totalQ)*100)+'%';
  showScreen('result');
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
}

